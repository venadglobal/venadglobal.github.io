RewriteEngine On

# 301 Redirect - Old Ponmudi URL to New Blog URL (Fixes Google Canonical Issue)
Redirect 301 /ponmudi-river-eco-tourism-resort.html /blog/ponmudi-river-eco-tourism-resort.html

# Security - Disable directory listing
Options -Indexes

# Force HTTPS (Uncomment if you use SSL - Recommended)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# Protect .htaccess
<Files .htaccess>
  Order Allow,Deny
  Deny from all
</Files>
